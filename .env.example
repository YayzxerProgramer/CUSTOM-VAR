# =====================================================================
# CUSTOM VAR - Variables de Entorno (Plantilla de Configuración)
# =====================================================================
# Copia este archivo a .env y define los valores correspondientes
# para el entorno local o de producción.

# Endpoint Webhook de n8n para el formulario de Soporte Técnico
VITE_N8N_WEBHOOK_URL=https://n8n.tudominio.com/webhook/soporte

# Endpoint Webhook de n8n para el formulario de Iniciativas / Responsabilidad Social
VITE_N8N_INICIATIVAS_WEBHOOK_URL=https://n8n.tudominio.com/webhook/iniciativas

# Token de autenticación Bearer para los Webhooks de n8n
VITE_N8N_WEBHOOK_TOKEN=tu_bearer_token_aqui

# Clave pública de sitio (Site Key) para Cloudflare Turnstile (Protección antibot)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxx
